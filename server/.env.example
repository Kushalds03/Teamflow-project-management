# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamflow_dev?schema=public"

# Authentication & Security
JWT_SECRET="dev-teamflow-jwt-super-secret-key-min-32-chars!"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="teamflow_token"
BCRYPT_ROUNDS=10
DEV_SEED_PASSWORD="DevPass123!"
