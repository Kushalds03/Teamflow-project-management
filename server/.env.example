# TeamFlow Backend Environment Configuration Example
# Copy this file to server/.env and fill in the required values.

# Server Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=production

# Client Web Application URL (Allowed CORS Origin)
CLIENT_URL=https://teamflow-app.vercel.app

# Database Connection (Neon PostgreSQL connection pooler string)
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"

# JWT Authentication Secret (Generate a strong 32+ character random string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters!
JWT_EXPIRES_IN=7d

# HttpOnly Cookie Name
COOKIE_NAME=teamflow_token

# Bcrypt Work Factor
BCRYPT_ROUNDS=10

# Development Seed Password (Optional, only used when running npm run prisma:seed in non-production)
DEV_SEED_PASSWORD=your_secure_dev_seed_password_here
